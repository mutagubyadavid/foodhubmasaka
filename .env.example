# Copy to ".env" and place it ABOVE your web root (best), or in /config/.env
# (the included .htaccess blocks web access). NEVER commit .env to git.

PESAJET_ENABLED=true
PESAJET_ENV=sandbox                       # sandbox | live
PESAJET_BASE_URL=https://api.sandbox.pesajet.example/v1   # <-- replace with the real URL
PESAJET_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PESAJET_SECRET_KEY=sk_test_xxxxxxxxxxxx
PESAJET_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
PESAJET_CURRENCY=UGX
PESAJET_PAID_ORDER_STATUS=confirmed       # must be a valid value of orders.order_status

# Your public site address, no trailing slash (used for callback + return URLs)
APP_URL=https://yourdomain.com
